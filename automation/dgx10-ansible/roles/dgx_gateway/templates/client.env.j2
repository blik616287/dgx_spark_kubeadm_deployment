{% set chat_models = dgx_catalog_meta | dict2items | selectattr('key', 'in', dgx_served_models) | selectattr('value.capabilities', 'contains', 'chat') | map(attribute='key') | list %}
# Source this file, then run the examples.
# The key is read from the cluster so it is never written here.
export DGX_GATEWAY_URL="{{ dgx_gateway_endpoint }}"
export DGX_GATEWAY_KEY="$(kubectl -n {{ dgx_gateway_namespace }} get secret litellm-master -o jsonpath='{.data.master-key}' | base64 -d)"
export DGX_GATEWAY_MODEL="{{ chat_models | first }}"
